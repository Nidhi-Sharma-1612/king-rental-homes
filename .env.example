# Copy this file to .env.local and fill in the values. .env.local is git-ignored — never commit real keys.
# Online booking switches on automatically once the Hostaway and Stripe values below are set.

# ── Hostaway ────────────────────────────────────────────────────────────────
# Hostaway dashboard → Settings → Hostaway API → Create. Account ID is shown on the same screen.
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_SECRET=
# Optional: a pre-generated access token (valid ~24 months). If set, the account ID/secret aren't used.
HOSTAWAY_ACCESS_TOKEN=
# Currency your Hostaway prices are in (3-letter code).
HOSTAWAY_CURRENCY=USD

# ── Stripe ──────────────────────────────────────────────────────────────────
# Stripe dashboard → Developers → API keys. Use sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Optional. Bookings work without it: the confirmation page and a background check (every ~2 min of site
# traffic) turn paid checkouts into Hostaway reservations. Adding a webhook makes this instant:
# Stripe dashboard → Developers → Webhooks → endpoint https://<your-domain>/api/webhooks/stripe
# (event: checkout.session.completed), then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Booking confirmations, refund notices, contact-form messages and host alerts.
# Google Workspace/Gmail: host smtp.gmail.com, port 465, and an App Password (Google Account → Security).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="King Rental Homes <you@example.com>"
# Where contact messages and booking alerts are delivered.
EMAIL_TO=

# ── Scheduled job (optional) ────────────────────────────────────────────────
# If set, GET /api/booking/reconcile with header "Authorization: Bearer <CRON_SECRET>" finishes any paid
# checkouts that aren't in Hostaway yet. Vercel Cron sends this header automatically.
CRON_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of the site, used for Stripe's return links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
